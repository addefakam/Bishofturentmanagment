generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  POLICE
  SUPERUSER
  OPERATOR
  STAFF
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  SUITE
  DELUXE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum PaymentStatusType {
  PAID
  PARTIAL
  PENDING
}

enum PaymentMethodType {
  CASH
  TRANSFER
  CARD
  MOBILE
}

enum ReservationStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum HousekeepingTaskType {
  CLEANING
  MAINTENANCE
  INSPECTION
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SuspectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Provider {
  id          String          @id @default(cuid())
  name        String
  ownerName   String
  phone       String
  email       String          @default("")
  address     String          @default("")
  type        String          @default("GUEST_HOUSE")
  licenseNo   String          @default("")
  licenseFile String          @default("")
  status      ProviderStatus  @default(PENDING)
  latitude    Float           @default(9.02)
  longitude   Float           @default(38.75)
  approvedBy  String?
  approvedAt  DateTime?
  rejectionReason String      @default("")
  latitude    Float           @default(9.02)
  longitude   Float           @default(38.75)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  users       User[]
  rooms       Room[]
  guests      Guest[]
  reservations Reservation[]
  expenses    Expense[]
  daytimeServices  DaytimeService[]
  daytimeBookings DaytimeBooking[]
  resources   Resource[]
  housekeepingTasks HousekeepingTask[]
  settings    Settings[]
  notifications Notification[]
}

model User {
  id          String          @id @default(cuid())
  username    String          @unique
  password    String
  role        UserRole        @default(STAFF)
  name        String
  permissions String          @default("[\"reservations\",\"guests\"]")  // JSON array of allowed pages for STAFF
  policeRank  String          @default("")  // ADMIN, DETECTIVE, OFFICER, VIEWER for POLICE role
  providerId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  provider    Provider?       @relation(fields: [providerId], references: [id])
}

model Room {
  id            String     @id @default(cuid())
  number        String
  name          String
  type          RoomType
  pricePerNight Float
  floor         Int
  capacity      Int
  status        RoomStatus @default(AVAILABLE)
  amenities     String
  description   String
  image         String?
  providerId    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  provider           Provider       @relation(fields: [providerId], references: [id])
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]

  @@unique([number, providerId])
}

model Guest {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String   @default("")
  idNumber    String   @default("")
  idType      String   @default("")
  nationality String   @default("")
  address     String   @default("")
  notes       String   @default("")
  vip         Boolean  @default(false)
  totalSpent  Float    @default(0)
  totalStays  Int      @default(0)
  providerId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider     Provider  @relation(fields: [providerId], references: [id])
  reservations Reservation[]
  reviews      Review[]
}

model Reservation {
  id              String            @id @default(cuid())
  guestId         String
  roomId          String
  checkIn         String
  checkOut        String
  nights          Int
  roomRate        Float
  totalCost       Float
  paidAmount      Float             @default(0)
  balance         Float             @default(0)
  paymentStatus   PaymentStatusType @default(PENDING)
  paymentMethod   PaymentMethodType?
  status          ReservationStatus @default(UPCOMING)
  notes           String            @default("")
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  taxAmount       Float             @default(0)
  discountAmount  Float             @default(0)
  providerId      String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  provider Provider  @relation(fields: [providerId], references: [id])
  guest    Guest    @relation(fields: [guestId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  payments Payment[]
  reviews  Review[]
}

model DaytimeService {
  id          String   @id @default(cuid())
  name        String
  price       Float
  category    String
  duration    String   @default("")
  description String   @default("")
  active      Boolean  @default(true)
  providerId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider        Provider        @relation(fields: [providerId], references: [id])
  daytimeBookings DaytimeBooking[]
}

model DaytimeBooking {
  id             String            @id @default(cuid())
  serviceId      String
  guestName      String
  guestPhone     String
  date           String
  time           String
  quantity       Int               @default(1)
  unitPrice      Float
  totalCost      Float
  paidAmount     Float             @default(0)
  paymentStatus  PaymentStatusType @default(PENDING)
  paymentMethod  PaymentMethodType?
  notes          String            @default("")
  providerId     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  provider Provider        @relation(fields: [providerId], references: [id])
  service  DaytimeService  @relation(fields: [serviceId], references: [id])
  payments Payment[]
}

model Expense {
  id            String            @id @default(cuid())
  date          String
  category      String
  description   String
  amount        Float
  vendor        String            @default("")
  paymentMethod PaymentMethodType
  receiptNo     String            @default("")
  taxAmount     Float             @default(0)
  providerId    String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  nameAm    String
  color     String
  icon      String
  createdAt DateTime @default(now())
}

model Resource {
  id           String   @id @default(cuid())
  name         String
  category     String
  quantity     Float
  unit         String
  minLevel     Float   @default(0)
  costPerUnit  Float   @default(0)
  supplier     String  @default("")
  lastRestocked DateTime?
  providerId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
}

model Payment {
  id               String            @id @default(cuid())
  reservationId    String?
  daytimeBookingId String?
  amount           Float
  method           PaymentMethodType
  referenceNo      String            @default("")
  notes            String            @default("")
  providerId       String
  createdAt        DateTime          @default(now())

  reservation    Reservation?    @relation(fields: [reservationId], references: [id])
  daytimeBooking DaytimeBooking? @relation(fields: [daytimeBookingId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  providerId String?
  userId    String?
  createdAt DateTime         @default(now())

  provider Provider? @relation(fields: [providerId], references: [id])
}

model HousekeepingTask {
  id            String                 @id @default(cuid())
  roomId        String
  type          HousekeepingTaskType
  status        HousekeepingTaskStatus @default(PENDING)
  assignedTo    String?
  scheduledDate String
  notes         String                 @default("")
  completedAt   DateTime?
  providerId    String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
}

model Review {
  id            String   @id @default(cuid())
  guestId       String
  reservationId String
  rating        Int
  comment       String   @default("")
  createdAt     DateTime @default(now())

  guest       Guest       @relation(fields: [guestId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  message    String
  type       String   @default("INFO")
  providerId String?
  createdAt  DateTime @default(now())
}

model Settings {
  id              String   @id @default(cuid())
  guestHouseName  String   @default("Guest House")
  ownerName       String   @default("")
  address         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  currency        String   @default("ETB")
  taxRate         Float    @default(0)
  language        String   @default("en")
  logo            String?
  checkInTime     String   @default("14:00")
  checkOutTime    String   @default("12:00")
  providerId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider Provider? @relation(fields: [providerId], references: [id])
}

// ─── Suspected Persons (Police-only) ─────────────────────────────────────────

model SuspectedPerson {
  id            String           @id @default(cuid())
  name          String
  phone         String           @default("")
  idNumber      String           @default("")
  idType        String           @default("")
  nationality   String           @default("")
  address       String           @default("")
  description   String           @default("")
  severity      SuspectSeverity  @default(MEDIUM)
  is_active     Boolean          @default(true)
  registeredBy  String           @default("")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  matches       SuspectMatch[]
}

model SuspectMatch {
  id              String           @id @default(cuid())
  suspectedPersonId String
  matchType       String           // "RESERVATION", "DAYTIME_BOOKING", "GUEST_CHECKIN"
  guestName       String
  guestPhone      String           @default("")
  guestIdNumber   String           @default("")
  providerName    String           @default("")
  providerId      String           @default("")
  reservationId   String?
  daytimeBookingId String?
  details         String           @default("")  // Full JSON details about the booking
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  suspectedPerson SuspectedPerson @relation(fields: [suspectedPersonId], references: [id])
}

// ─── Police Intelligence & Security ─────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  officerName String   @default("")
  action      String   // VIEW_GUEST, VIEW_MATCH, EXPORT_DATA, LOGIN, etc.
  targetId    String?
  targetType  String?  @default("")
  details     String?
  ipAddress   String?  @default("")
  createdAt   DateTime @default(now())
}

model Geofence {
  id          String   @id @default(cuid())
  name        String
  address     String   @default("")
  latitude    Float    @default(0)
  longitude   Float    @default(0)
  radius      Float    @default(1000) // meters
  severity    String   @default("HIGH")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FrequentStayAlert {
  id             String   @id @default(cuid())
  guestName      String
  guestPhone     String   @default("")
  guestIdNumber  String   @default("")
  providerNames  String   @default("[]") // JSON array of provider names
  stayCount      Int      @default(0)
  avgDaysBetween Float    @default(0)
  riskLevel      String   @default("MEDIUM")
  isReviewed     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model PoliceAlertConfig {
  id                   String   @id @default(cuid())
  emailEnabled         Boolean  @default(false)
  emailRecipients      String   @default("[]") // JSON array of email addresses
  smsEnabled           Boolean  @default(false)
  smsRecipients        String   @default("[]") // JSON array of phone numbers
  escalationDelayMins  Int      @default(60) // minutes before escalating HIGH severity
  criticalImmediate    Boolean  @default(true) // CRITICAL alerts are immediate
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}